# Salin file ini jadi .env.local, isi dengan nilai asli dari Supabase.
# Project Settings > API di dashboard Supabase.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-public-key

# RAHASIA. Jangan pernah diberi prefix NEXT_PUBLIC_, jangan di-commit,
# jangan dikirim ke browser. Hanya dipakai server action pembuatan akun.
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key
